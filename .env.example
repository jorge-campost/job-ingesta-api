# Más cada {env:NOMBRE} usado en parameters.json, por ejemplo:
# MODIFIED_FROM=2026-11-02T00:00:00
# MODIFIED_TO=2026-11-03T00:00:00

# --- Opcionales ---
# Endpoints separados por comas; vacío = todos
ENDPOINTS=
