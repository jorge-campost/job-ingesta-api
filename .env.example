# --- Obligatorias ---
# Claves según auth.tipo: none: apiUrl | basic: +username, password | bearer: +token | apiKey: +apiKey
API_CONFIG={"apiUrl":"https://api.frankfurter.dev/v2"}
BUCKET=dev-stg-gst-comex-001
TABLA_LOG=jclab-dev-brz-tmp.ext_comex.ctl_log_ingesta
