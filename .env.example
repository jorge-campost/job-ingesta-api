# Copia este archivo como .env y completa los valores. El .env NO se sube a GitHub ni a la imagen.
# Sin comillas alrededor de los valores, para que sirva también con "docker run --env-file .env".

# En Cloud Run este valor viene del secreto api-config (Secret Manager).
# Claves según auth.tipo de src/config/parameters.json:
#   none -> apiUrl | basic -> apiUrl, username, password | bearer -> apiUrl, token | apiKey -> apiUrl, apiKey
API_CONFIG={"apiUrl":"https://api.frankfurter.dev/v2","username":"usuario-demo","password":"clave-demo"}

BUCKET=dev-stg-gst-comex-001
# Obligatoria, formato estricto YYYY-MM-DD. Día al que pertenecen los datos (en la corrida diaria, D-1)
FECHA_DATOS=2026-11-02

# Tabla de control. Si la dejas vacía, el job no registra en BigQuery (solo deja un warning)
TABLA_LOG=jclab-dev-brz-tmp.ext_comex.ctl_log_ingesta

# Opcionales (en Cloud Run las envía Airflow)
# incremental (por defecto) o snapshot
TIPO_CARGA=incremental
# Vacío = todos los endpoints de parameters.json. Ejemplo: rates,currencies
ENDPOINTS=
# true = vuelve a extraer aunque ya exista una ejecución OK para ese día
FORZAR=false
AIRFLOW_DAG_ID=manual
AIRFLOW_TASK_ID=manual
AIRFLOW_RUN_ID=manual
INTENTO=1

# Proyecto para las librerías de Google cuando corres en tu PC
GOOGLE_CLOUD_PROJECT=jclab-dev-brz-tmp
