# Copia este archivo como .env y completa los valores: copy .env.example .env
# El .env es solo para tu PC: NO se sube a GitHub ni entra en la imagen.
# Sin comillas alrededor de los valores, para que sirva también con "docker run --env-file .env".
#
# Cada variable indica si es OBLIGATORIA u OPCIONAL y de dónde sale en Cloud Run:
#   [Secret Manager] secreto montado con --set-secrets en cloudbuild.yaml
#   [Config del job] fija en el job, --set-env-vars en cloudbuild.yaml
#   [Airflow]        la envía el DAG en cada ejecución (override)
#   [Manual]         solo si la pasas tú: gcloud run jobs execute ... --update-env-vars=...
#   [Solo local]     no se usa en Cloud Run

# ======================================================================
# OBLIGATORIAS
# ======================================================================

# [Secret Manager: api-config] URL y credenciales de la API.
# Claves según auth.tipo de src/config/parameters.json:
#   none -> apiUrl | basic -> apiUrl, username, password | bearer -> apiUrl, token | apiKey -> apiUrl, apiKey
API_CONFIG={"apiUrl":"https://api.frankfurter.dev/v2","username":"usuario-demo","password":"clave-demo"}

# [Config del job] Bucket de crudos
BUCKET=dev-stg-gst-comex-001

# [Config del job] Tabla de control (proyecto.dataset.tabla). Créala antes con sql/ddl_ctl_log_ingesta.sql
TABLA_LOG=jclab-dev-brz-tmp.ext_comex.ctl_log_ingesta

# [Airflow] Día al que pertenecen los datos, formato estricto YYYY-MM-DD.
# En la corrida diaria es D-1; en un reproceso, el parámetro fecha_datos del DAG.
FECHA_DATOS=2026-11-02

# [Airflow] Cada {env:NOMBRE} que uses en los params de parameters.json es obligatorio.
# Frankfurter solo usa FECHA_DATOS. Ejemplos para otras APIs:
# MODIFIED_FROM=2026-11-02T00:00:00
# MODIFIED_TO=2026-11-03T00:00:00
# CONTINENTE=europe

# ======================================================================
# OPCIONALES
# ======================================================================

# [Airflow] Endpoints a procesar (claves de parameters.json), separados por comas. Vacío = todos.
# El tipo de carga lo define el modo de cada endpoint. Ejemplo: rates o rates,currencies
ENDPOINTS=

# [Manual] true = vuelve a extraer aunque ya exista una ejecución OK para ese día. Por defecto false
FORZAR=false

# [Airflow] Trazabilidad que se guarda en el manifest y en la tabla de control.
# En local quedan como "manual" y 1 (también es el valor si no se definen).
AIRFLOW_DAG_ID=manual
AIRFLOW_TASK_ID=manual
AIRFLOW_RUN_ID=manual
INTENTO=1

# ======================================================================
# SOLO LOCAL
# ======================================================================

# [Solo local] Proyecto para las librerías de Google en tu PC.
# En Cloud Run no hace falta: lo toma del entorno del job.
GOOGLE_CLOUD_PROJECT=jclab-dev-brz-tmp

# Nota: CLOUD_RUN_EXECUTION la define Cloud Run sola en cada ejecución; en local vale "local".
